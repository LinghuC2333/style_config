# SSH tunnel to the style_config server
SSH_HOST=8.133.3.63
SSH_USER=root

# Prefer an SSH key. If omitted, set SSH_PASSWORD in the OS keyring or
# process environment instead of writing the password into this file.
# SSH_KEY_PATH=~/.ssh/id_ed25519

# Remote Postgres, reached through the SSH tunnel
PG_DB=style_config
PG_USER=style_config
PG_REMOTE_HOST=127.0.0.1
PG_REMOTE_PORT=5432

# Set PG_PASSWORD in the OS keyring or process environment.
